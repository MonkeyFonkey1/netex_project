# Local PostgreSQL configuration. Copy this file to .env and choose a password.
# Read by Docker Compose and by the backend's local profile.
# Keep plain KEY=value lines; avoid quotes, export, backslashes or variable expansion.
POSTGRES_DB=netex
POSTGRES_USER=netex
POSTGRES_PASSWORD=replace-with-your-local-password

# Optional: set both values to create one admin account at backend startup.
# Keep real credentials only in the ignored .env file, never in Git.
ADMIN_EMAIL=
ADMIN_PASSWORD=
